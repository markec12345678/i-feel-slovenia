# Environment Variables Example
# Copy this file to .env and fill in the actual values

# Application
VITE_APP_TITLE=Music-Band
VITE_APP_URL=https://music-band.vercel.app

# Analytics (optional)
VITE_UMAMI_WEBSITE_ID=your-website-id
VITE_UMAMI_URL=https://analytics.example.com

# Contact Form (optional)
VITE_CONTACT_FORM_ENDPOINT=https://api.example.com/contact

# Social Links (optional)
VITE_SOCIAL_INSTAGRAM=https://instagram.com/music-band
VITE_SOCIAL_TWITTER=https://twitter.com/music-band
VITE_SOCIAL_YOUTUBE=https://youtube.com/music-band
